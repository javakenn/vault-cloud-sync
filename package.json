{
  "name": "vault-cloud-sync",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Sync notes and attachments across devices using your own Cloudflare backend, with conflict copies and version recovery.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && npm run build:worker && tsx --test tests/*.test.ts",
    "build:worker": "wrangler deploy --dry-run --outdir .data/cloudflare-build",
    "setup:cloudflare": "npm run build && node scripts/setup-cloudflare.mjs",
    "devices": "node scripts/devices.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.local.jsonc",
    "dev": "npm run build && wrangler dev",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "eslint": "10.14.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "miniflare": "5.20261023.3-beta",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
