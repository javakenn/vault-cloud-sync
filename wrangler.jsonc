{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vault-cloud-sync",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "VAULT_ID": "notes",
    "READ_ONLY": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-cloud-sync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "vault-cloud-sync-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
