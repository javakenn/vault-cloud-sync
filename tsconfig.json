{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "plugin/**/*.ts",
    "packages/**/*.ts",
    "cloudflare/**/*.ts",
    "backend/**/*.ts",
    "tests/**/*.ts"
  ]
}
